NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy public key remains supported.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: used only for constrained public booking RPC, never sent to browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_PROVIDER=local
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@localhost:5432/IC_Room_Schedule
LOCAL_SESSION_SECRET=
# Explicitly enables READ-ONLY demo data when Supabase is not configured.
DEMO_MODE=false
# Server-only Gmail SMTP. Use a Google App Password with 2-Step Verification.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=innovation.centre4@gmail.com
SMTP_PASSWORD=
