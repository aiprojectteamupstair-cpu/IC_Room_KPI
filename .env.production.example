# Add these to Vercel Project Settings > Environment Variables > Production.
# These belong to the same hosted Supabase project.
DATABASE_PROVIDER=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only booking key. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
DEMO_MODE=false
# Legacy keys NEXT_PUBLIC_SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY also work.
# DATABASE_URL and LOCAL_SESSION_SECRET are not used by the Supabase provider.
